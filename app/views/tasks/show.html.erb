<h1><%= @task.title %></h1>
<p><%= @task.description%></p>
<p><%= @task.due_on%></p>
<% case @task.priority %>
<% when 0 %>
  <p> Basse</p>
<% when 1 %>
  <p> Normale</p>
<% when 2 %>
  <p> Haute</p>
<% end %>

<% case @task.done %>
<% when true %>
  <p> Fait</p>
<% when false %>
  <p> Non fait</p>
<% end %>
<p><%= @task.created_at%></p>
<%= link_to "Retour à la liste", tasks_path %>
<%= link_to "Modifier", edit_task_path(@task) %>
<%= button_to "Supprimer", @task, method: :delete, data: { turbo_confirm: "Supprimer cette tâche ?" } %>