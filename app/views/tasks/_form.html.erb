<%= form_with model: task do |form| %>
   <div>
    <%= form.label :title, "Titre" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :due_on, "Échéance" %>
    <%= form.date_field :due_on, placeholder: "jj/mm/aaaa" %>
  </div>

  <div>
    <%= form.label :priority, "Priorité" %>
    <%= form.select :priority, [["Basse", 0], ["Normale", 1], ["Haute", 2]], selected: task.priority || 1 %>
  </div>

  <div>
    <%= form.label :done, "Terminée" %>
    <%= form.check_box :done %>
  </div>

  <div>
    <%= form.label :description, "Description" %>
    <%= form.text_area :description %>
  </div>

  <%= form.submit %>
<% end %>