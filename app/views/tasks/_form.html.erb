<%= form_with(model: task, html: { class: "form" }) do |form| %>
   <div>
    <%= form.label :title, "Titre" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :due_on, "Échéance" %>
    <%= form.date_field :due_on %>
  </div>

  <div>
    <%= form.label :priority, "Priorité" %>
    <%= form.select :priority, [["Basse", 0], ["Normale", 1], ["Haute", 2]], selected: task.priority || 1 %>
  </div>

  <div>
    <%= form.label :user_id, "Responsable" %>
    <% if Current.user.manager? %>
      <%= form.collection_select :user_id, User.order(:name), :id, :name, { include_blank: "— Non assignée —" } %>
    <% else %>
      <%= form.collection_select :user_id, User.order(:name), :id, :name, { include_blank: "— Non assignée —", selected: Current.user&.id }, { disabled: true } %>
      <%= form.hidden_field :user_id, value: Current.user&.id %>
    <% end %>
  </div>

  <div>
    <%= form.label :done, "Terminée" %>
    <%= form.check_box :done %>
  </div>

  <div>
    <%= form.label :description, "Description" %>
    <%= form.text_area :description %>
  </div>

  <%= form.submit %>
<% end %>